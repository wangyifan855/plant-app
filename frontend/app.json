{
  "expo": {
    "name": "Avo 植物管家",
    "slug": "graftcheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["android", "web"],
    "sdkVersion": "51.0.0",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "extra": {
      "apiUrl": "http://10.133.5.44:8010"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "需要访问摄像头以拍摄接穗 / 砧木照片",
          "photosPermission": "需要访问相册以选择植物照片"
        }
      ]
    ],
    "android": {
      "package": "com.graftcheck.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    }
  }
}
